// Stage-one adapters. This file is appended before static reachability pruning.
// U8 is represented by Field in this single-module port; all external bytes and
// all byte-operation outputs go through the complete generated byte tables.
type U8 = Field;
inline fn store<T>(value: T) -> &T { &value }
inline fn load<T>(pointer: &T) -> T { *pointer }
inline fn to_field(byte: U8) -> Field { byte }
inline fn eq_zero(x: Field) -> Field { match x { 0 => 1, _ => 0 } }

// A stream is reconstructed by ordinary Aiur stores. Hints contain only values.
inline fn io_get_info<T>(channel: Field, key: T) -> (Field, Field) {
    hint::<(Field, Field)>((channel, key))
}
inline fn unconstrained_g_to_bytes(x: Field) -> [Field; 8] {
    hint::<[Field; 8]>((5, x))
}

table byte_inputs: (Field,) {}
table byte_values: Field {}
table byte_bits: [Field; 8] {}
table pair_inputs: (Field, Field) {}
table pair_xors: Field {}
table pair_ands: Field {}
table pair_ors: Field {}
table pair_lts: Field {}
table pair_adds: (Field, Field) {}
table pair_subs: (Field, Field) {}
table pair_muls: (Field, Field) {}
table pair_xor_parts4: (Field, Field) {}
table pair_xor_parts7: (Field, Field) {}
table sum_inputs: (Field,) {}
table sum_bytes: Field {}
map u8_from_field_unsafe(x: Field) -> U8 = byte_inputs => byte_values;
map u8_bit_decomposition(x: U8) -> [Field; 8] = byte_inputs => byte_bits;
map u8_xor(a: U8, b: U8) -> U8 = pair_inputs => pair_xors;
map u8_and(a: U8, b: U8) -> U8 = pair_inputs => pair_ands;
map u8_or(a: U8, b: U8) -> U8 = pair_inputs => pair_ors;
map u8_less_than(a: U8, b: U8) -> Field = pair_inputs => pair_lts;
map u8_add(a: U8, b: U8) -> (U8, U8) = pair_inputs => pair_adds;
map u8_sub(a: U8, b: U8) -> (U8, U8) = pair_inputs => pair_subs;
map u8_mul(a: U8, b: U8) -> (U8, U8) = pair_inputs => pair_muls;
map u8_xor_split4(a: U8, b: U8) -> (U8, U8) = pair_inputs => pair_xor_parts4;
map u8_xor_split7(a: U8, b: U8) -> (U8, U8) = pair_inputs => pair_xor_parts7;
map sum_byte(x: Field) -> Field = sum_inputs => sum_bytes;
inline fn split_sum(x: Field) -> (Field, Field) {
    let byte = sum_byte(x);
    (byte, (x - byte) / 256)
}
inline fn u8_range_check(a: Field, b: Field) -> (U8, U8) {
    (u8_from_field_unsafe(a), u8_from_field_unsafe(b))
}
fn checked_u32_bytes(x: Field) -> [U8; 4] {
    let [a, b, c, d, _, _, _, _] = unconstrained_g_to_bytes(x);
    let (a, b) = u8_range_check(a, b);
    let (c, d) = u8_range_check(c, d);
    assert_eq!(x, a + 256*b + 65536*c + 16777216*d, "u32 decomposition");
    [a, b, c, d]
}
fn u32_less_than(a: Field, b: Field) -> Field {
    let a = checked_u32_bytes(a);
    let b = checked_u32_bytes(b);
    match a[3] - b[3] {
      0 => { match a[2] - b[2] {
        0 => { match a[1] - b[1] {
          0 => u8_less_than(a[0], b[0]),
          _ => u8_less_than(a[1], b[1]),
        } },
        _ => u8_less_than(a[2], b[2]),
      } },
      _ => u8_less_than(a[3], b[3]),
    }
}

// Binary long division using ordinary recursive calls. No quotient pointers are
// accepted as advice; division by zero follows Lean Nat.div/Nat.mod.
fn ordinary_div_mod(a: KLimbs, b: KLimbs) -> (KLimbs, KLimbs) {
    let a = klimbs_normalize(a);
    let b = klimbs_normalize(b);
    match klimbs_is_zero(b) {
      1 => (store(ListNode::Nil), a),
      _ => divide_grow(a, b),
    }
}
fn divide_grow(a: KLimbs, b: KLimbs) -> (KLimbs, KLimbs) {
    match klimbs_le(b, a) {
      0 => (store(ListNode::Nil), a),
      _ => {
        let (q, r) = divide_grow(a, klimbs_add(b, b));
        let q = klimbs_add(q, q);
        match klimbs_le(b, r) {
          0 => (q, r),
          _ => (klimbs_succ(q), klimbs_sub(r, b)),
        }
      },
    }
}

fn stream_equal(a: ByteStream, b: ByteStream) -> Field {
    match (load(a), load(b)) {
      (ListNode::Nil, ListNode::Nil) => 1,
      (ListNode::Cons(x, xs), ListNode::Cons(y, ys)) => {
        match x - y { 0 => stream_equal(xs, ys), _ => 0 }
      },
      _ => 0,
    }
}
fn verify_serde(digest: [Field; 32]) -> () {
    let (idx, len) = io_get_info(2, digest);
    let bytes = read_byte_stream(2, idx, len);
    verify_bytes_against(bytes, digest);
    let (constant, rest) = get_constant(bytes);
    let ListNode::Nil = load(rest);
    let output = put_constant(constant, store(ListNode::Nil));
    assert_eq!(stream_equal(bytes, output), 1, "Ixon serialization round trip");
    ()
}
fn verify_constant(digest: [Field; 32]) -> () { run_check(store(digest)) }
fn verify_transitive(digest: [Field; 32]) -> () { run_check_transitive(store(digest)) }
fn check_primitives() -> () {
    assert_eq!(u32_add([255; 4], [1,0,0,0]), [0; 4], "u32 carry");
    assert_eq!(u32_less_than(255, 256), 1, "u32 compare");
    assert_eq!(u32_less_than(256, 255), 0, "u32 compare reverse");
    let a = store(ListNode::Cons([25,0,0,0,0,0,0,0], store(ListNode::Nil)));
    let b = store(ListNode::Cons([7,0,0,0,0,0,0,0], store(ListNode::Nil)));
    let (q,r) = ordinary_div_mod(a,b);
    let ListNode::Cons(q0, qt) = load(q);
    let ListNode::Nil = load(qt);
    assert_eq!(q0, [3,0,0,0,0,0,0,0], "division");
    let ListNode::Cons(r0, rt) = load(r);
    let ListNode::Nil = load(rt);
    assert_eq!(r0, [4,0,0,0,0,0,0,0], "remainder");
    ()
}
