     203, 3, 192, 240, 71, 90, 241, 82,
     57, 157, 239, 255, 146, 38, 198, 225,
     159, 214, 72, 4, 26, 104, 153, 169])
  }

  fn quot_lift_addr() -> Addr {
    store([134, 179, 101, 231, 91, 180, 35, 15,
     4, 198, 228, 243, 167, 202, 105, 136,
     173, 245, 116, 97, 109, 121, 163, 215,
