    store([69, 4, 11, 49, 38, 133, 81, 105,
     218, 217, 25, 169, 112, 169, 199, 44,
     238, 88, 117, 101, 138, 237, 179, 189,
     31, 137, 252, 223, 140, 136, 237, 250])
  }

